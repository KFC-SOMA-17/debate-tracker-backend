# dev 프로파일이 참조하는 비밀정보 모음.
# 실제 dev-secret.yml 은 커밋하지 않는다 (.gitignore).
#   - CD 는 GitHub Secret `DEV_SECRET_YML` 의 내용을 이 위치에 써서 이미지에 굽는다.
#   - 로컬에서 dev 프로파일을 띄울 땐 이 파일을 복사해 dev-secret.yml 로 만들고 값을 채운다.
#       cp dev-secret.yml.example dev-secret.yml
# application-dev.yml 이 ${secret.*} 로 이 값들을 참조한다.
secret:
  datasource:
    host: localhost
    port: 13306
    database: debate
    username: debate
    password: debate
  redis:
    host: localhost
    port: 16379
  aws:
    access-key-id: your-aws-access-key-id
    secret-access-key: your-aws-secret-access-key
    region: us-east-1
  azure:
    enabled: true
    subscription-key: your-azure-speech-key
  cors:
    origin: http://localhost:3000,http://localhost:5173
